# Copy this file to ".env" and adjust.

# --- How the API reaches SurrealDB -------------------------------------------
# Option A (normal): a SurrealDB server you started yourself.
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_USER=root
SURREAL_PASS=secret
SURREAL_NS=campus
SURREAL_DB=connect

# Option B (no install needed): SurrealDB's embedded engine, bundled in npm.
# Uncomment to run everything inside the Node process (data lives in memory).
# SURREAL_URL=mem://

# --- API ---------------------------------------------------------------------
PORT=4000
# The React dev server origin(s), comma separated
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Seed demo data automatically when the students table is empty
AUTO_SEED=true
# Allow the "Reset demo data" button / POST /api/admin/reseed
ALLOW_RESET=true

{
  "name": "campus-connect-server",
  "version": "1.0.0",
  "description": "Campus Connect API: graph-powered student network on SurrealDB",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "db:check": "node src/dbcheck.js",
    "test": "node --test test/api.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "surrealdb": "^2.1.1"
  },
  "optionalDependencies": {
    "@surrealdb/node": "^3.1.0"
  }
}
